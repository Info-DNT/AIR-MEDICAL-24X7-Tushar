# Copy to .env and fill in. .env is gitignored; this template is not.
#
#     cp .env.example .env
#     python tools/build-config.py     # writes the values into js/config.js
#
# READ THIS BEFORE ASSUMING .env MAKES ANYTHING SECRET
#
# It does not. This is a static site with no build server and no server-side
# rendering, so the browser must receive these values to work at all — they are
# in the delivered JavaScript and readable in DevTools regardless of this file.
#
# That is expected. Every value below is public by design:
#
#   * the Supabase anon key is a public identifier; Row Level Security is what
#     protects the data, not secrecy of the key
#   * the Turnstile SITE key is meant to appear in the page; the SECRET key is
#     held by Cloudflare and the Edge Function
#
# The point of this file is a single place to change the values, not privacy.
#
# The one genuine secret, the Supabase service_role key, MUST NOT go in here.
# It bypasses Row Level Security completely. Paste it into the admin panel's
# Settings tab at runtime instead — js/config.js keeps it out of source on
# purpose (see rebindBlogsSupabaseClient).

SUPABASE_URL=https://YOUR-PROJECT.supabase.co/
SUPABASE_ANON_KEY=

BLOGS_SUPABASE_URL=https://YOUR-PROJECT.supabase.co/
BLOGS_SUPABASE_ANON_KEY=

TURNSTILE_SITE_KEY=
